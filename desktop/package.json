{
  "name": "neon-eclipse-desktop",
  "productName": "NEON ECLIPSE",
  "version": "1.3.0",
  "description": "NEON ECLIPSE — six chapters, naval combat, flight missions and local flight records",
  "author": "NEON ECLIPSE",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "stage": "node stage.cjs",
    "dev": "npm run stage && electron .",
    "pack": "npm run stage && electron-builder --win portable --x64",
    "verify": "node verify.cjs",
    "smoke": "node smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "game.neoneclipse.desktop",
    "productName": "NEON ECLIPSE",
    "asar": true,
    "directories": {
      "output": "../release-desktop"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NEON-ECLIPSE-1.3.0-win-x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
